# Copy to .env (never commit .env). On Vercel, set the same names under
# Project -> Settings -> Environment Variables.

# The only required value: a free Gemini key from https://aistudio.google.com/apikey
# Create it in a Google project WITHOUT billing, so an exhausted quota can never cost money.
# Without it the game still works; rounds are marked "nije provereno".
GEMINI_API_KEY=

# Optional. Comma-separated, tried in order; the next one is used only when the previous one
# fails with a temporary error or is out of its daily quota. Stable model IDs only.
# GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash

# Optional. Overrides the thinking level for every model. By default Flash models get "minimal"
# (much faster) and lite models get none.
# GEMINI_THINKING_LEVEL=

# Local debugging only: print what we send and what the model replies to the `npm run dev`
# terminal. Never the key. Ignored on Vercel and in production. Turn it off when done.
# AI_DEBUG_LOG=1
